NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Database connection (isolated Docker container on port 5434)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=digital_wallet
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/digital_wallet

# Test Database connection
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/digital_wallet_test

# JWT secret
JWT_SECRET=super-secret-jwt-key-for-digital-wallet-token-minimum-32-chars

# Rate limiting
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_TRANSFER_MAX=60
RATE_LIMIT_TRANSFER_WINDOW_MS=60000
